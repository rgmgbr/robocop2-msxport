868c  level2_header        objlist $A828, hazards $95B2, specials $8FE0, spawn $97B0, start (160h, 310h), relocation (C0h, 70h), markers $C5EC, lowest camera 270h, timer 07:30, spawn delay 2Eh, marker mask 7, palette $10036
8fe0  speciallist_level2   $9088 $9098 $90AA $90BC $90CC (lifts) $90DE $90EE $90FE $910E (trolleys)
95b2  hazards_level2       7 vats
97b0  spawnlist_level2     (was spawnlist_level1) 40 entries: 10 hostages (45), 2 x type 1, 6 x 49, 9 x 5, 1 x 6, 1 x 2, 1 x 14, 2 x 4, 3 x 12, 5 x 13
a828  objlist_level2       (was objlist_level1) 44 entries: 4 x type 0Ch (act_0c), 1 relocation, 7 crates/cans with pickups, 16 floor switches, 15 explode-look-4 crates
c5ec  markers_level2       types 3, 4, 12, 13, 14, 15, 16, 30, 31
927a  vat_top_words        16 map words (surface row) by D3 / 2
929a  vat_odd_words        16 map words (rows 1, 3, ...)
92ba  vat_even_words       16 map words (rows 2, 4, ...)
c7e0  t1_legs_gfx          16 words: graphic offset from $3E810
c800  t1_torso_dy          8 words
d17c  t5_size              11 words: BLTSIZE per frame - 1
d19a  t5_gfx               11 words: graphic offset from $3BFC0
d1b0  t5_dx                11 words
d2da  t6_gfx               8 words: graphic offset from $3C920
e680  fly_dx               16 words: x step (x2) per direction (0 up, 4 right, 8 down, 0Ch left)
e6a0  fly_dy               16 words: y step (x2)
e7b2  fly_gfx              16 words: graphic offset per direction
